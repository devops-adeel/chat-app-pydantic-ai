ANTHROPIC_API_KEY=your_anthropic_key_here
TAVILY_API_KEY=your_tavily_key_here

# --- Temporal memory (Graphiti) -------------------------------------------
# Storage is local: Neo4j running in Docker (docker compose up neo4j). The same
# password is consumed by docker-compose.yml and by the app.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please_change_me
# One stable id scopes this single user's memory graph.
MEMORY_USER_ID=default
# Intelligence is rented: OpenAI powers embeddings + reranking (one key for both).
OPENAI_API_KEY=your_openai_key_here
# Extraction runs on Claude; embeddings + reranking on OpenAI. Override if you like:
# MEMORY_EXTRACTION_MODEL=claude-sonnet-4-6
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# Keep 1536 (text-embedding-3-small's native size); smaller values truncate + degrade:
# MEMORY_EMBEDDING_DIM=1536
# gpt-4o-mini is a CHAT model used as the LLM reranker (it cannot embed):
# MEMORY_RERANK_MODEL=gpt-4o-mini

# Restate endpoints
RESTATE_INGRESS=http://localhost:8080
RESTATE_ADMIN=http://localhost:9070
# Mac Docker Desktop: host.docker.internal resolves correctly out of the box
# Linux Docker: change to http://172.17.0.1:8000/restate-service
SERVICE_ENDPOINT=http://host.docker.internal:8000/restate-service

# Langfuse — activate when self-hosted server is live
# Replace ConsoleSpanExporter with OTLPSpanExporter in instrumentation.py
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
